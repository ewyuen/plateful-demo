# Copy to .env (git-ignored) and fill in. Django does not read this file by itself;
# let uv load it:
#   cd backend && env -u VIRTUAL_ENV uv run --env-file .env python manage.py runserver
# Never commit real values. The PayPal secret in particular must stay out of git.

# Local development only: turns on debug and allows the development secret key.
DJANGO_DEBUG=true

# PayPal sandbox credentials from developer.paypal.com (Apps & Credentials, Sandbox).
# Optional: without them the payment endpoints answer 503 and the rest of the API works.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Claude API key for the menu assistant (console.anthropic.com). Optional: without it
# the assistant answers 503 and the rest of the app works. Set a spend limit on the key.
ANTHROPIC_API_KEY=
# Optional overrides: the model (default claude-haiku-5-5) and the per-client rate limit.
# ASSISTANT_MODEL=claude-haiku-5-5
# ASSISTANT_RATE=20/min

# Staff login (ADR-0014). Defaults suit local development.
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DJANGO_SECURE_COOKIES=true     # only when served over HTTPS
# LOGIN_RATE=10/min
# CHECKOUT_RATE=30/min
# NUM_PROXIES=1                  # the Ingress counts as one proxy
# LOOKUP_RATE=20/min
# REGISTER_RATE=10/hour
