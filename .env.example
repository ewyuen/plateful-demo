# Copy to .env and fill in. .env is git-ignored: never commit real values.
# Used by docker-compose.yml (see "Run it" in README.md).

# Required. Generate with: openssl rand -hex 32
DJANGO_SECRET_KEY=CHANGE_ME
# Required. Any password: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME

# PayPal SANDBOX credentials from https://developer.paypal.com (Apps and Credentials,
# Sandbox). Optional: without them the page says payment is unavailable.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: Claude API key from https://console.anthropic.com. Without it the menu
# assistant says it is unavailable and the rest of the app works.
ANTHROPIC_API_KEY=

# Optional.
# PROXY_PORT=8080
# ASSISTANT_MODEL=claude-haiku-5-5
# ASSISTANT_RATE=20/min
